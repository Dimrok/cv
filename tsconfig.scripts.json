{
  "extends": "@tsconfig/node20/tsconfig.json",
  "include": ["scripts/**/*", "src/data/**/*", "src/lib/**/*", "src/localization/**/*", "src/types/**/*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  }
}
