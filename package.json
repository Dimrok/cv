{
  "name": "cv",
  "homepage": "https://dimrok.github.io/cv",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "predeploy": "build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "resume:generate": "tsx scripts/generate-resume.ts",
    "resume:pdf": "make -C resume/latex",
    "resume": "run-s resume:generate resume:pdf",
    "lint:oxlint": "oxlint . --fix -D correctness",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s 'lint:**'",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "vue": "^3.5.44",
    "vue-i18n": "10",
    "vue-meta": "^2.4.0",
    "vue-router": "^5.4.0",
    "vue-star-rating": "^2.1.0"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.10",
    "@types/gh-pages": "^6.1.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "depcheck": "^1.4.7",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.90.0",
    "eslint-plugin-vue": "^10.12.0",
    "gh-pages": "^6.3.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsx": "4.19.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "yarn@4.5.1",
  "volta": {
    "node": "22.5.1",
    "yarn": "4.5.3"
  }
}
