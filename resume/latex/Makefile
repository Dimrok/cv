# Builds build/resume.pdf from resume.tex (generated by `yarn resume:generate`).
#
#   make          build with the local TeX installation if latexmk is found,
#                 otherwise inside the texlive/texlive Docker image
#   make local    force the local TeX installation (needs latexmk + lualatex)
#   make docker   force Docker
#   make watch    rebuild on change (local only)
#   make clean    remove build artefacts

REPO_ROOT := $(abspath ../..)
OUT_DIR := build
TEXLIVE_IMAGE ?= texlive/texlive:latest
LATEXMK := latexmk -lualatex -interaction=nonstopmode -halt-on-error -outdir=$(OUT_DIR)

ifneq ($(shell command -v latexmk 2>/dev/null),)
DEFAULT_TARGET := local
else
DEFAULT_TARGET := docker
endif

.PHONY: all local docker watch clean

all: $(DEFAULT_TARGET)

local:
	$(LATEXMK) resume.tex

docker:
	docker run --rm \
		--user "$$(id -u):$$(id -g)" \
		--env HOME=/tmp \
		--volume "$(REPO_ROOT):/workdir" \
		--workdir /workdir/resume/latex \
		$(TEXLIVE_IMAGE) \
		$(LATEXMK) resume.tex

watch:
	$(LATEXMK) -pvc resume.tex

clean:
	rm -rf $(OUT_DIR)
